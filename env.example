# ==============================================================================
# Ingestion API Configuration
# ==============================================================================
FLOW_API_FOOTBALL_KEY=your_football_api_key

# ==============================================================================
# AWS Configuration & Credentials
# ==============================================================================
FLOW_AWS_ACCESS_KEY_ID=your_aws_access_key_id
FLOW_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=eu-central-1
AWS_S3_LANDING_BUCKET_NAME=football-data-pipeline-landing-zone-dev

# ==============================================================================
# Airflow Metadata DB (PostgreSQL)
# ==============================================================================
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow

# ==============================================================================
# Airflow Web UI Credentials
# ==============================================================================
_AIRFLOW_WWW_USER_USERNAME=your_airflow_username
_AIRFLOW_WWW_USER_PASSWORD=your_airflow_password

# ==============================================================================
# Kestra Metadata DB (PostgreSQL)
# ==============================================================================
KESTRA_POSTGRES_USER=kestra
KESTRA_POSTGRES_PASSWORD=your_kestra_db_password
KESTRA_POSTGRES_DB=kestra

# ==============================================================================
# Kestra Web UI Credentials
# ==============================================================================
KESTRA_USER=valid_email
KESTRA_PASSWORD=your_kestra_password

# ==============================================================================
# Airflow Environment & Security
# ==============================================================================
# Host user mapping for local volumes (run `id -u` on host)
AIRFLOW_UID=your_local_user_UID

# Host docker socket group ID (run `getent group docker | cut -d: -f3` on host)
AIRFLOW_DOCKER_GID=your_docker_group_gid

# Encryption key for metadata connections
# Generate: uv run --with cryptography python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here

# JWT Auth Configuration for Airflow API
# Generate Secret: openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=your_generated_jwt_secret_here
AIRFLOW__API_AUTH__JWT_ISSUER=football-data-pipeline