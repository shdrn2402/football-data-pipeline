# ==============================================================================
# Local CLI Runs
# ==============================================================================
# Variables for `uv run`: copy to .env.local and set PIPELINE_ENV_PATH=.env.local
# The orchestrators use env.example instead

# ==============================================================================
# Ingestion API Configuration
# ==============================================================================
API_FOOTBALL_KEY=your_football_api_key
# Optional pause between API requests in seconds, for a paid plan (default: config.yaml)
# API_DELAY_SECONDS=0.5

# ==============================================================================
# AWS Configuration & Credentials
# ==============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=eu-central-1
AWS_S3_LANDING_BUCKET_NAME=football-data-pipeline-landing-zone-dev

# ==============================================================================
# ClickHouse Database Configuration
# ==============================================================================
# Host and port of the ClickHouse service published by a running stack
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=your_clickhouse_db_password
CLICKHOUSE_DB=clickhouse
